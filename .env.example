# Django settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Lagos
# Static files
DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=C:\path\to\staticfiles

# Database (default is SQLite db.sqlite3)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=db.sqlite3
# For Postgres/MySQL/etc:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=microhr
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=secret
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Security / proxy (useful in production)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# If behind a proxy that sets X-Forwarded-Proto:
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# DJANGO_USE_X_FORWARDED_HOST=True

# Email / SMTP
# Development default prints emails to the server console:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Digi02 HR <noreply@digi02hr.local>
# Production SMTP example:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your@email.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_TIMEOUT=10
# The app also accepts Django's standard names without the DJANGO_ prefix:
# EMAIL_BACKEND, EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS, EMAIL_USE_SSL, EMAIL_TIMEOUT, DEFAULT_FROM_EMAIL

# IMAP inbox reading
# Defaults to the SMTP host/user/password where possible:
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_HOST_USER=your@email.com
# IMAP_HOST_PASSWORD=your-app-password
# IMAP_USE_SSL=True
# IMAP_MAILBOX=INBOX
# IMAP_TIMEOUT=10
